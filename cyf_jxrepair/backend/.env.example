# 复制为 backend/.env 后按本机情况修改（start.bat / start.sh 首次运行会自动复制）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=cyf_jxrepair

# 生产环境务必修改为随机长字符串
JWT_SECRET=cyf-jxrepair-please-change-this-secret
JWT_EXPIRE_MINUTES=480

# 超期预警：阈值（小时）与扫描间隔（秒）
ALERT_THRESHOLD_HOURS=48
ALERT_SCAN_INTERVAL_SECONDS=300

# 可选：大模型（兼容 OpenAI 协议，如 DeepSeek / 通义千问）。留空则使用本地离线知识库
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
